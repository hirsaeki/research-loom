{
  "schema_version": "0.1.0",
  "profile_id": "misco.writer",
  "profile_type": "narrative",
  "profile_version": "1.1.0",
  "description": "Production MISCO Writer/Narrative profile. It instantiates the minimal canonical Narrative projection required by Research Package 0.2.0 and delivers the Human-approved clean Layer A Writer rules plus their detached source text without creating research decisions.",
