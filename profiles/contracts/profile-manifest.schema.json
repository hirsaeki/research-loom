{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:research-loom:profiles:profile-manifest:0.1.0","title":"research-loom canonical profile manifest","description":"Implementation-neutral manifest for declarative Research, Organization, Narrative, and Publication profiles.","type":"object","additionalProperties":false,"required":["schema_version","profile_id","profile_type","profile_version","core_compatibility"],"properties":{"schema_version":{"const":"0.1.0"},"profile_id":{"$ref":"#/$defs/profile_id"},"profile_type":{"$ref":"#/$defs/profile_type"},"profile_version":{"$ref":"#/$defs/semver"},"description":{"type":"string"},"core_compatibility":{"$ref":"#/$defs/core_compatibility"},"extends":{"type":"array","items":{"$ref":"#/$defs/profile_requirement"},"uniqueItems":true,"default":[]},"requires":{"type":"array","items":{"$ref":"#/$defs/profile_requirement"},"uniqueItems":true,"default":[]},"constraints":{"type":"array","items":{"$ref":"#/$defs/constraint_declaration"},"default":[]},"core_invariant_strengthenings":{"type":"array","items":{"$ref":"#/$defs/invariant_strengthening"},"default":[]},"resources":{"type":"array","items":{"$ref":"#/$defs/resource"},"default":[]}},"allOf":[{"if":{"properties":{"profile_type":{"const":"research"}},"required":["profile_type"]},"then":{"properties":{"extends":{"items":{"$ref":"#/$defs/research_requirement"}}}}},{"if":{"properties":{"profile_type":{"const":"organization"}},"required":["profile_type"]},"then":{"properties":{"extends":{"items":{"$ref":"#/$defs/organization_requirement"}}}}},{"if":{"properties":{"profile_type":{"const":"narrative"}},"required":["profile_type"]},"then":{"properties":{"extends":{"items":{"$ref":"#/$defs/narrative_requirement"}}}}},{"if":{"properties":{"profile_type":{"const":"publication"}},"required":["profile_type"]},"then":{"properties":{"extends":{"items":{"$ref":"#/$defs/publication_requirement"}}}}}],"$defs":{"profile_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"