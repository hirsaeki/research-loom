+def _compose_constraints(selected: list[Mapping[str, Any]]) -> list[dict[str, Any]]:
+    groups: dict[str, list[tuple[Mapping[str, Any], Mapping[str, Any]]]] = {}
+    for candidate in selected:
+        for declaration in candidate["manifest"].get("constraints", ()):
+            if str(declaration["path"]).startswith("core."):
+                raise LocalWorkspaceError("PROFILE-CORE-INVARIANT-001", "Profile constraint cannot use reserved core.* path")
+            groups.setdefault(str(declaration["path"]), []).append((candidate, declaration))
+
+    result: list[dict[str, Any]] = []
+    for path in sorted(groups):
+        declarations = groups[path]
+        strategies = {str(declaration["merge_strategy"]) for _, declaration in declarations}
+        if len(strategies) != 1:
+            raise LocalWorkspaceError("PROFILE-COMP-STRATEGY-001", f"constraint path {path} has incompatible merge strategies")
+        strategy = next(iter(strategies))
+        values = [declaration["value"] for _, declaration in declarations]
+        if strategy == "union":
+            value = _set_like(member for members in values for member in members)
+            resolution = "single" if len(values) == 1 else "union"
+        elif strategy == "intersection":
+            encoded_sets = [{_canonical_bytes(member) for member in members} for members in values]
+            common = set.intersection(*encoded_sets) if encoded_sets else set()
+            value = [json.loads(encoded.decode("utf-8")) for encoded in sorted(common)]
+            resolution = "single" if len(values) == 1 else "intersection"
+        elif strategy == "must_equal":
+            if any(value != values[0] for value in values[1:]):
+                raise LocalWorkspaceError("PROFILE-COMP-CONFLICT-001", f"must_equal conflict at {path}")
+            value = deepcopy(values[0])
+            resolution = "single" if len(values) == 1 else "identical"
+        elif strategy == "max":
+            value = max(values)
+            resolution = "single" if len(values) == 1 else "max"
+        elif strategy == "min":
+            value = min(values)
+            resolution = "single" if len(values) == 1 else "min"
+        elif strategy == "replace":
+            if any(value != values[0] for value in values[1:]):
+                raise LocalWorkspaceError("PROFILE-COMP-REPLACE-001", f"non-identical replace declarations at {path} require explicit descendant precedence")
+            value = deepcopy(values[0])
+            resolution = "single" if len(values) == 1 else "identical"
+        else:
+            raise LocalWorkspaceError("PROFILE-COMP-STRATEGY-001", f"unsupported merge strategy {strategy}")
+        provenance = [{**_pin(candidate), "constraint_id": declaration["id"]} for candidate, declaration in declarations]
+        provenance.sort(key=_constraint_source_key)
+        result.append({
+            "path": path,
+            "merge_strategy": strategy,
+            "value": value,
+            "resolution": resolution,
+            "provenance": provenance,
+        })
+    return result
+
+
+def _load_yaml(path: Path) -> Mapping[str, Any]:
+    value = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if not isinstance(value, Mapping):
+        raise LocalWorkspaceError("PROFILE-CONTRACT-001", f"canonical YAML contract is invalid: {path}")
+    return value
+
