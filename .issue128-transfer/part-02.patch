+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-VALUE-001", f"Narrative stage identity/role is invalid at {path}")
+                    if not _unique_strings(item["consumes"], set(vocabularies["research_input_kind"])) or not _unique_strings(item["requires"], set(vocabularies["research_input_kind"])) or not _unique_strings(item["produces"], set(vocabularies["narrative_product"])):
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-VALUE-001", f"Narrative stage vocabulary is invalid at {path}")
+                    normalized = (item["semantic_role"], tuple(sorted(item["consumes"])), tuple(sorted(item["requires"])), tuple(sorted(item["produces"])))
+                    prior = stages.get(item["id"])
+                    if prior is not None and prior != normalized:
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-IDENTITY-001", f"Narrative stage identity conflicts: {item['id']}")
+                    stages[item["id"]] = normalized
+            elif shape == "dependency_set":
+                for item in value:
+                    if not isinstance(item, Mapping) or set(item) != {"from_stage", "to_stage", "relation"} or not isinstance(item["from_stage"], str) or not item["from_stage"] or not isinstance(item["to_stage"], str) or not item["to_stage"] or item["from_stage"] == item["to_stage"] or item["relation"] not in vocabularies["dependency_relation"]:
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-VALUE-001", f"Narrative dependency is malformed at {path}")
+                    edge = (item["from_stage"], item["to_stage"])
+                    prior = dependencies.get(edge)
+                    if prior is not None and prior != item["relation"]:
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-IDENTITY-001", f"Narrative dependency identity conflicts: {edge}")
+                    dependencies[edge] = item["relation"]
+            elif shape == "section_purpose_set":
+                for item in value:
+                    if not isinstance(item, Mapping) or set(item) != {"id", "purpose_role", "stage_ids"} or not isinstance(item["id"], str) or not item["id"] or item["purpose_role"] not in vocabularies["section_purpose_role"] or not isinstance(item["stage_ids"], list) or not item["stage_ids"] or len(item["stage_ids"]) != len(set(item["stage_ids"])) or any(not isinstance(stage_id, str) or not stage_id for stage_id in item["stage_ids"]):
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-VALUE-001", f"Narrative section purpose is malformed at {path}")
+                    normalized = (item["purpose_role"], tuple(sorted(item["stage_ids"])))
+                    prior = purposes.get(item["id"])
+                    if prior is not None and prior != normalized:
+                        raise LocalWorkspaceError("PROFILE-NARRATIVE-IDENTITY-001", f"Narrative section purpose identity conflicts: {item['id']}")
+                    purposes[item["id"]] = normalized
+
+    for source, target in dependencies:
+        if source not in stages or target not in stages:
+            raise LocalWorkspaceError("PROFILE-NARRATIVE-REF-001", "Narrative dependency references an undeclared stage")
+    for _purpose_id, (_role, stage_ids) in purposes.items():
+        if any(stage_id not in stages for stage_id in stage_ids):
+            raise LocalWorkspaceError("PROFILE-NARRATIVE-REF-001", "Narrative section purpose references an undeclared stage")
+    graph = {stage_id: [] for stage_id in stages}
+    for source, target in dependencies:
+        graph[source].append(target)
+    visiting: set[str] = set()
+    done: set[str] = set()
+
+    def visit(stage_id: str) -> None:
+        if stage_id in visiting:
+            raise LocalWorkspaceError("NARRATIVE-DEPENDENCY-CYCLE-001", "Narrative dependency graph contains a cycle")
+        if stage_id in done:
+            return
+        visiting.add(stage_id)
+        for target in graph[stage_id]:
+            visit(target)
+        visiting.remove(stage_id)
+        done.add(stage_id)
+
+    for stage_id in graph:
+        visit(stage_id)
+
