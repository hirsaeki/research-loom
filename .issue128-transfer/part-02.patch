+def _strengthening_form(registry: Mapping[str, Any], strengthening: Mapping[str, Any]) -> Mapping[str, Any] | None:
+    invariant = registry["invariants"].get(strengthening["invariant_id"])
+    if not isinstance(invariant, Mapping) or invariant.get("strengthening_policy") != "registered_forms":
+        return None
+    binding = strengthening["validator_binding"]
+    for validator in invariant.get("validators", ()):
+        if validator.get("validator_id") != binding["validator_id"] or validator.get("validator_version") != binding["validator_version"]:
+            continue
+        for form in validator.get("approved_forms", ()):
+            if form.get("form_id") == binding["form_id"]:
+                return form
+    return None
+
+
+def _compose_core_invariants(selected: list[Mapping[str, Any]]) -> list[dict[str, Any]]:
+    catalog = _load_yaml(INVARIANT_CATALOG)
+    registry = _load_yaml(STRENGTHENING_REGISTRY)
+    strengthenings: dict[str, list[dict[str, Any]]] = {}
+    for candidate in selected:
+        manifest = candidate["manifest"]
+        constraints = {str(item["id"]): item for item in manifest.get("constraints", ())}
+        for strengthening in manifest.get("core_invariant_strengthenings", ()):
+            form = _strengthening_form(registry, strengthening)
+            if form is None:
+                raise LocalWorkspaceError("PROFILE-CORE-STRENGTHENING-001", "Profile strengthening does not resolve to a registered validator form")
+            referenced = []
+            for constraint_id in strengthening["constraint_ids"]:
+                constraint = constraints.get(str(constraint_id))
+                if constraint is None:
+                    raise LocalWorkspaceError("PROFILE-MANIFEST-REF-001", "Profile strengthening references an unknown constraint")
+                referenced.append(constraint)
+            for required in form.get("required_constraints", ()):
+                match = next((constraint for constraint in referenced if constraint["path"] == required["path"] and constraint["merge_strategy"] == required["merge_strategy"]), None)
+                if match is None:
+                    raise LocalWorkspaceError("PROFILE-CORE-STRENGTHENING-001", "Profile strengthening does not satisfy registered required constraints")
+                schema = required.get("value_schema") or {}
+                if "const" in schema and match["value"] != schema["const"]:
+                    raise LocalWorkspaceError("PROFILE-CORE-STRENGTHENING-001", "Profile strengthening value does not satisfy registered form")
+            source = {
+                **_pin(candidate),
+                "constraint_ids": list(strengthening["constraint_ids"]),
+                "validator_binding": deepcopy(dict(strengthening["validator_binding"])),
+            }
+            strengthenings.setdefault(str(strengthening["invariant_id"]), []).append(source)
+
+    result = []
+    for item in catalog["invariants"]:
+        invariant_id = str(item["id"])
+        provenance = strengthenings.get(invariant_id, [])
+        provenance.sort(key=lambda source: (
+            _TYPE_RANK[source["profile_type"]], source["profile_id"], _semver(source["profile_version"]), source["manifest_sha256"],
+            source["validator_binding"]["validator_id"], source["validator_binding"]["validator_version"], source["validator_binding"]["form_id"],
+        ))
+        result.append({"invariant_id": invariant_id, "status": "strengthened" if provenance else "preserved", "provenance": provenance})
+    return result
+
