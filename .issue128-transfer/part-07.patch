+    def test_ablation_history_guard_detects_missing_history(self):
+        resolution = self._resolve_target()
+        original = SQLiteResearchStateRepository.advance_project_profile_binding
+        def without_history(repository, **kwargs):
+            original(repository, **kwargs)
+            repository._connection.execute("DELETE FROM profile_binding_history WHERE event_id = ?", (kwargs["event_id"],))
+        with patch.object(SQLiteResearchStateRepository, "advance_project_profile_binding", without_history):
+            LocalApplicationFacade.advance_profile_generation(self.workspace, {"resolution": resolution})
+        self.assertEqual(LocalApplicationFacade.profile_binding_history(self.workspace)["history"], [])
+        # The acceptance condition detects the ablation: a committed generation change without history is invalid.
+        with self.assertRaises(AssertionError):
+            self.assertEqual(len(LocalApplicationFacade.profile_binding_history(self.workspace)["history"]), 1)
