{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-loom:core:research-method-result-extension:0.1.0",
  "title": "research-loom Research Method Capability result extension",
  "description": "Method-independent design/run/analyze metadata bound to one exact PR9 Capability Handoff. Raw method data and analysis remain candidate material and never become authoritative Evidence, Analysis, Finding, or Method by this extension.",
  "type":"object","additionalProperties":false,
  "required":["schema_version","extension_type","handoff_binding","generated_method_design_refs","generated_protocol_refs","generated_instrument_refs","run_results","candidate_analyses","candidate_finding_ids","candidate_next_action_ids","candidate_next_method_ids","extension_digest"],
  "properties": {
    "schema_version":{"const":"0.1.0"},"extension_type":{"const":"research_method_result"},"handoff_binding":{"$ref":"#/$defs/handoff_binding"},
    "generated_method_design_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/generated_method_design_ref"}},
    "generated_protocol_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/generated_protocol_ref"}},
    "generated_instrument_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/generated_instrument_ref"}},
    "run_results":{"type":"array","items":{"$ref":"#/$defs/run_result"}},
    "candidate_analyses":{"type":"array","items":{"$ref":"#/$defs/candidate_analysis"}},
    "candidate_finding_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}},
    "candidate_next_action_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}},
    "candidate_next_method_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}},
    "extension_digest":{"$ref":"#/$defs/digest"}
  },
  "$defs": {
    "identifier":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},"token":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,127}$"},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"semver":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "handoff_binding": {
      "type":"object","additionalProperties":false,
      "required":["handoff_id","handoff_digest","invocation_id","run_id","context_pack_id","context_pack_digest","capability_id","function_id"],
      "properties":{"handoff_id":{"$ref":"#/$defs/identifier"},"handoff_digest":{"$ref":"#/$defs/digest"},"invocation_id":{"$ref":"#/$defs/identifier"},"run_id":{"$ref":"#/$defs/identifier"},"context_pack_id":{"$ref":"#/$defs/identifier"},"context_pack_digest":{"$ref":"#/$defs/digest"},"capability_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$"},"function_id":{"enum":["method_design","instrument_design","execute","analyze"]}}
    },
    "generated_method_design_ref": {
      "type":"object","additionalProperties":false,"required":["method_design_id","version","content_digest","authoritative_method","adoption_performed"],
      "properties":{"method_design_id":{"$ref":"#/$defs/identifier"},"version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"},"authoritative_method":{"const":false},"adoption_performed":{"const":false}}
    },
    "generated_protocol_ref": {
      "type":"object","additionalProperties":false,"required":["protocol_id","version","content_digest","approval_status","adoption_performed"],
      "properties":{"protocol_id":{"$ref":"#/$defs/identifier"},"version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"},"approval_status":{"const":"candidate"},"adoption_performed":{"const":false}}
    },
    "generated_instrument_ref": {
      "type":"object","additionalProperties":false,"required":["instrument_id","version","content_digest","approval_status","adoption_performed"],
      "properties":{"instrument_id":{"$ref":"#/$defs/identifier"},"version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"},"approval_status":{"const":"candidate"},"adoption_performed":{"const":false}}
    },
    "versioned_ref": {
      "type":"object","additionalProperties":false,"required":["id","version","content_digest"],
      "properties":{"id":{"$ref":"#/$defs/identifier"},"version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"}}
    },
    "raw_data_ref": {
      "type":"object","additionalProperties":false,
      "required":["data_ref_id","data_kind","locator","content_digest","epistemic_mode","evidence_adoption_performed"],
      "properties":{"data_ref_id":{"$ref":"#/$defs/identifier"},"data_kind":{"enum":["observation","response","measurement","other"]},"locator":{"type":"string","minLength":1},"content_digest":{"$ref":"#/$defs/digest"},"epistemic_mode":{"enum":["empirical","synthetic","unknown"]},"handoff_observation_id":{"$ref":"#/$defs/identifier"},"evidence_adoption_performed":{"const":false}}
    },
    "missing_data": {
      "type":"object","additionalProperties":false,"required":["missing_id","kind","statement"],
      "properties":{"missing_id":{"$ref":"#/$defs/identifier"},"kind":{"enum":["missingness","dropout","unavailable_data"]},"statement":{"type":"string","minLength":1},"related_data_ref_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}}}
    },
    "coverage_item": {
      "type":"object","additionalProperties":false,"required":["dimension_id","status","rationale"],
      "properties":{"dimension_id":{"$ref":"#/$defs/identifier"},"status":{"enum":["covered","partial","uncovered","not_applicable"]},"rationale":{"type":"string","minLength":1}}
    },
    "validity_report": {
      "type":"object","additionalProperties":false,"required":["validity_report_id","threats","limitations","coverage","finding_adoption_performed"],
      "properties":{"validity_report_id":{"$ref":"#/$defs/identifier"},"threats":{"type":"array","items":{"type":"string","minLength":1}},"limitations":{"type":"array","items":{"type":"string","minLength":1}},"coverage":{"type":"array","items":{"$ref":"#/$defs/coverage_item"}},"finding_adoption_performed":{"const":false}}
    },
    "run_result": {
      "type":"object","additionalProperties":false,
      "required":["run_result_id","run_spec_ref","protocol_ref","completion_status","input_digest","raw_data_refs","missing_data","validity_report","research_completion_claimed"],
      "properties":{"run_result_id":{"$ref":"#/$defs/identifier"},"run_spec_ref":{"$ref":"#/$defs/versioned_ref"},"protocol_ref":{"$ref":"#/$defs/versioned_ref"},"completion_status":{"enum":["complete","partial","incomplete","failed"]},"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"},"input_digest":{"$ref":"#/$defs/digest"},"raw_data_refs":{"type":"array","items":{"$ref":"#/$defs/raw_data_ref"}},"missing_data":{"type":"array","items":{"$ref":"#/$defs/missing_data"}},"validity_report":{"$ref":"#/$defs/validity_report"},"research_completion_claimed":{"const":false}}
    },
    "candidate_analysis": {
      "type":"object","additionalProperties":false,"required":["candidate_analysis_id","source_run_result_ids","summary","limitations","core_analysis_adoption_performed"],
      "properties":{"candidate_analysis_id":{"$ref":"#/$defs/identifier"},"source_run_result_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}},"summary":{"type":"string","minLength":1},"limitations":{"type":"array","items":{"type":"string","minLength":1}},"core_analysis_adoption_performed":{"const":false}}
    }
  }
}
