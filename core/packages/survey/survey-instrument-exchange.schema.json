{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-loom:core:survey-instrument-exchange:0.1.0",
  "title": "research-loom provider-neutral Survey Instrument Exchange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "exchange_type", "survey_id", "survey_version",
    "survey_content_digest", "instrument_id", "instrument_version",
    "instrument_content_digest", "title", "description", "rq_ids",
    "snapshot_binding", "sections"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "exchange_type": {"const": "research_loom_survey_instrument"},
    "survey_id": {"$ref": "#/$defs/id"},
    "survey_version": {"$ref": "#/$defs/semver"},
    "survey_content_digest": {"$ref": "#/$defs/digest"},
    "instrument_id": {"$ref": "#/$defs/id"},
    "instrument_version": {"$ref": "#/$defs/semver"},
    "instrument_content_digest": {"$ref": "#/$defs/digest"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rq_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "snapshot_binding": {"$ref": "#/$defs/snapshot_binding"},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "snapshot_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage_ref", "snapshot_ref", "snapshot_digest"],
      "properties": {
        "lineage_ref": {"type": "string", "minLength": 1},
        "snapshot_ref": {"type": "string", "minLength": 1},
        "snapshot_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "choice": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "missing_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["missing", "unknown_value", "not_applicable_value", "prefer_not_to_answer_value"],
      "properties": {
        "missing": {"const": "no_response"},
        "unknown_value": {"type": ["string", "null"]},
        "not_applicable_value": {"type": ["string", "null"]},
        "prefer_not_to_answer_value": {"type": ["string", "null"]}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "variable", "type", "prompt", "required", "choices", "scale",
        "validation", "branching", "missing_value_semantics",
        "randomization_group_id", "traceability"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "variable": {"$ref": "#/$defs/id"},
        "type": {"enum": ["single_choice", "multiple_choice", "scale", "numeric", "free_text"]},
        "prompt": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
        "scale": {"type": ["object", "null"]},
        "validation": {"type": ["object", "null"]},
        "branching": {"type": "array", "items": {"type": "object"}},
        "missing_value_semantics": {"$ref": "#/$defs/missing_semantics"},
        "randomization_group_id": {"type": ["string", "null"]},
        "traceability": {"type": "object"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "description", "questions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
      }
    }
  }
}
