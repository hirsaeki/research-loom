{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-loom:core:survey-response-canonical:0.1.0",
  "title": "research-loom canonical persisted SurveyResponse",
  "description": "Canonical provider-neutral Survey response bound to one exact Survey Instrument revision. Origin, epistemic status, answer state, validation, and acquisition provenance remain explicit and do not imply Evidence adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "project_id", "response_id", "instrument_ref",
    "participant_id", "identity_namespace", "response_origin", "epistemic_status",
    "response_status", "dropout", "answers", "ingested_at", "raw_input_digest",
    "normalization_events", "validation", "source_provenance",
    "verified_evidence_claimed", "research_state_mutation_performed",
    "content_digest", "registry_digest"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "object_type": {"const": "survey_response"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "response_id": {"$ref": "#/$defs/identifier"},
    "instrument_ref": {"$ref": "#/$defs/instrument_ref"},
    "participant_id": {"$ref": "#/$defs/identifier"},
    "identity_namespace": {"type": "string", "pattern": "^(synthetic|real):[A-Za-z0-9._:-]+$"},
    "response_origin": {"enum": ["synthetic", "real"]},
    "epistemic_status": {"enum": ["SYNTHETIC_TEST_ONLY", "EMPIRICAL"]},
    "response_status": {"enum": ["complete", "partial"]},
    "dropout": {"type": "boolean"},
    "answers": {"type": "array", "items": {"$ref": "#/$defs/answer"}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "source_run_id": {"$ref": "#/$defs/identifier"},
    "source_provenance": {"type": "object"},
    "raw_input_digest": {"$ref": "#/$defs/digest"},
    "normalization_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "response_key": {"$ref": "#/$defs/identifier"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {"$ref": "#/$defs/validation"},
    "verified_evidence_claimed": {"const": false},
    "research_state_mutation_performed": {"const": false},
    "content_digest": {"$ref": "#/$defs/digest"},
    "registry_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"response_origin": {"const": "synthetic"}}, "required": ["response_origin"]},
      "then": {
        "properties": {
          "epistemic_status": {"const": "SYNTHETIC_TEST_ONLY"},
          "identity_namespace": {"pattern": "^synthetic:"}
        }
      }
    },
    {
      "if": {"properties": {"response_origin": {"const": "real"}}, "required": ["response_origin"]},
      "then": {
        "properties": {
          "epistemic_status": {"const": "EMPIRICAL"},
          "identity_namespace": {"pattern": "^real:"}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "instrument_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "content_digest"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "response_key", "state"],
      "properties": {
        "question_id": {"$ref": "#/$defs/identifier"},
        "response_key": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["answered", "missing", "unknown", "not_applicable", "prefer_not_to_answer", "not_asked"]},
        "value": {}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "answered"}}, "required": ["state"]},
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"state": {"enum": ["missing", "unknown", "not_applicable", "prefer_not_to_answer", "not_asked"]}}, "required": ["state"]},
          "then": {"not": {"required": ["value"]}}
        }
      ]
    },
    "issue": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning"]},
        "message": {"type": "string", "minLength": 1},
        "response_id": {"type": "string"},
        "response_key": {"type": "string"}
      },
      "additionalProperties": true
    },
    "preservation": {
      "type": "object",
      "required": ["kind", "response_id", "detail"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "response_id": {"type": "string", "minLength": 1},
        "response_key": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues", "preservation_events"],
      "properties": {
        "status": {"enum": ["accepted", "rejected"]},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "preservation_events": {"type": "array", "items": {"$ref": "#/$defs/preservation"}}
      }
    }
  }
}
