{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-loom:core:survey-contract:0.1.0",
  "title": "research-loom canonical Survey specialization",
  "oneOf": [
    {"$ref": "#/$defs/questionnaire"},
    {"$ref": "#/$defs/context_extension"},
    {"$ref": "#/$defs/result_extension"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "content_digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/semver"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["construct_ids", "research_question_ids", "evidence_gap_ids"],
      "properties": {
        "construct_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "research_question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence_gap_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "anyOf": [
        {"properties": {"construct_ids": {"minItems": 1}}},
        {"properties": {"research_question_ids": {"minItems": 1}}},
        {"properties": {"evidence_gap_ids": {"minItems": 1}}}
      ]
    },
    "missing_value_semantics": {
      "type": "object", "additionalProperties": false,
      "required": ["missing"],
      "properties": {
        "missing": {"const": "no_response"},
        "unknown_option_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "not_applicable_option_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "prefer_not_to_answer_option_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "item_revision", "text", "question_type", "required", "response_options", "branching", "traceability"],
      "properties": {
        "question_id": {"$ref": "#/$defs/id"},
        "response_key": {"$ref": "#/$defs/id"},
        "section_id": {"$ref": "#/$defs/id"},
        "item_revision": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "question_type": {"enum": ["single_choice", "multiple_choice", "scale", "numeric", "free_text"]},
        "required": {"type": "boolean"},
        "response_options": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["option_id", "label"],
            "properties": {
              "option_id": {"$ref": "#/$defs/id"},
              "value": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1}
            }
          }
        },
        "scale": {"type": ["object", "null"]},
        "numeric_constraints": {"type": ["object", "null"]},
        "branching": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["condition_question_id", "operator", "action"],
            "properties": {
              "condition_question_id": {"$ref": "#/$defs/id"},
              "operator": {"enum": ["equals", "not_equals", "contains", "answered", "missing"]},
              "value": {},
              "action": {"enum": ["show", "skip", "end"]},
              "target_question_id": {"$ref": "#/$defs/id"}
            }
          }
        },
        "missing_value_semantics": {"$ref": "#/$defs/missing_value_semantics"},
        "randomization_group_id": {"type": ["string", "null"]},
        "traceability": {"$ref": "#/$defs/trace"}
      }
    },
    "questionnaire": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "object_type", "questionnaire_id", "version", "approval_status", "material_revision", "retired_question_ids", "revision_changes", "questions", "content_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "survey_questionnaire"},
        "questionnaire_id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/semver"},
        "approval_status": {"enum": ["candidate", "approved", "rejected"]},
        "approval_decision_id": {"$ref": "#/$defs/id"},
        "material_revision": {"type": "boolean"},
        "material_revision_decision_id": {"$ref": "#/$defs/id"},
        "supersedes_version": {"$ref": "#/$defs/semver"},
        "retired_question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "revision_changes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["question_id", "change_kind", "material"],
            "properties": {
              "question_id": {"$ref": "#/$defs/id"},
              "change_kind": {"enum": ["wording", "scale", "response_options", "branching", "requiredness", "order", "metadata"]},
              "material": {"type": "boolean"}
            }
          }
        },
        "sections": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["section_id", "title"],
            "properties": {
              "section_id": {"$ref": "#/$defs/id"},
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string"}
            }
          }
        },
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "context_extension": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "object_type", "research_method_context_digest", "function_id", "survey_design_ref", "questionnaire_ref", "duplicate_response_policy", "missing_data_policy", "questionnaire_decision_ids", "extension_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "survey_context_extension"},
        "research_method_context_digest": {"$ref": "#/$defs/digest"},
        "function_id": {"enum": ["method_design", "instrument_design", "execute", "analyze"]},
        "survey_design_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "questionnaire_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "duplicate_response_policy": {"enum": ["keep_first", "keep_last", "exclude_all", "manual_review", "allow_with_flag"]},
        "missing_data_policy": {"const": "preserve"},
        "questionnaire_decision_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "extension_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["response_id", "raw_data_ref_id", "response_status", "eligibility_status", "epistemic_mode", "duplicate_disposition", "verified_evidence_claimed"],
      "properties": {
        "response_id": {"$ref": "#/$defs/id"},
        "raw_data_ref_id": {"$ref": "#/$defs/id"},
        "response_status": {"enum": ["complete", "partial"]},
        "eligibility_status": {"enum": ["eligible", "excluded", "unknown"]},
        "response_timestamp": {"type": "string", "format": "date-time"},
        "epistemic_mode": {"enum": ["empirical", "virtual", "synthetic", "unknown"]},
        "duplicate_disposition": {"enum": ["not_duplicate", "kept", "excluded", "unresolved"]},
        "exclusion_reason": {"type": "string"},
        "verified_evidence_claimed": {"const": false}
      }
    },
    "item_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "denominator_count", "answered_count", "missing_count", "excluded_count"],
      "properties": {
        "question_id": {"$ref": "#/$defs/id"},
        "denominator_count": {"type": "integer", "minimum": 0},
        "answered_count": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0}
      }
    },
    "result_extension": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "object_type", "research_method_result_digest", "responses", "sample_disposition", "item_summaries", "aggregation_provenance_ref", "subgroup_provenance_refs", "free_text_coding_refs", "limitations", "response_bias_candidate", "missing_data_preserved", "target_sample_achieved", "research_sufficiency_claimed", "aggregate_is_finding", "finding_adoption_performed", "synthetic_responses_may_be_empirical", "extension_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "survey_result_extension"},
        "research_method_result_digest": {"$ref": "#/$defs/digest"},
        "responses": {"type": "array", "items": {"$ref": "#/$defs/response"}},
        "sample_disposition": {
          "type": "object",
          "required": ["response_count", "completed_count", "partial_count", "nonresponse_count", "dropout_count", "excluded_response_count", "duplicate_flagged_count"],
          "properties": {
            "eligible_count": {"type": ["integer", "null"], "minimum": 0},
            "response_count": {"type": "integer", "minimum": 0},
            "completed_count": {"type": "integer", "minimum": 0},
            "partial_count": {"type": "integer", "minimum": 0},
            "nonresponse_count": {"type": "integer", "minimum": 0},
            "dropout_count": {"type": "integer", "minimum": 0},
            "excluded_response_count": {"type": "integer", "minimum": 0},
            "duplicate_flagged_count": {"type": "integer", "minimum": 0}
          }
        },
        "item_summaries": {"type": "array", "items": {"$ref": "#/$defs/item_summary"}},
        "aggregation_provenance_ref": {"type": "string", "minLength": 1},
        "subgroup_provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "free_text_coding_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "response_bias_candidate": {"type": "object"},
        "missing_data_preserved": {"const": true},
        "target_sample_achieved": {"type": "boolean"},
        "research_sufficiency_claimed": {"const": false},
        "aggregate_is_finding": {"const": false},
        "finding_adoption_performed": {"const": false},
        "synthetic_responses_may_be_empirical": {"const": false},
        "extension_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
