    "pin":{"type":"object","additionalProperties":false,"required":["ref","content_digest"],"properties":{"ref":{"$ref":"#/$defs/id"},"content_digest":{"$ref":"#/$defs/digest"}}},
    "treatment":{"type":"object","additionalProperties":false,"required":["object_kind","source_ref","treatment","reason"],"properties":{"object_kind":{"type":"string","minLength":1},"source_ref":{"$ref":"#/$defs/id"},"derived_ref":{"$ref":"#/$defs/id"},"treatment":{"enum":["PRESERVE","RECONFIRM","INVALIDATE"]},"reason":{"type":"string","minLength":1},"human_decision_ref":{"$ref":"#/$defs/id"}}},
