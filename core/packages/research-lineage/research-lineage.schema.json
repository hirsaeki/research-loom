    "comparison":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","comparison_id","project_ref","left_lineage_ref","right_lineage_ref","left_snapshot","right_snapshot","changes","read_only","automatic_adoption_performed","comparison_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"lineage_comparison"},"comparison_id":{"$ref":"#/$defs/id"},"project_ref":{"$ref":"#/$defs/id"},"left_lineage_ref":{"$ref":"#/$defs/id"},"right_lineage_ref":{"$ref":"#/$defs/id"},"left_snapshot":{"$ref":"#/$defs/snapshot"},"right_snapshot":{"$ref":"#/$defs/snapshot"},"changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["object_kind","object_ref","change"],"properties":{"object_kind":{"type":"string","minLength":1},"object_ref":{"$ref":"#/$defs/id"},"change":{"enum":["added","removed-from-effective-lineage","revised","preserved","conflicting","unknown"]}}}},"read_only":{"const":true},"automatic_adoption_performed":{"const":false},"comparison_digest":{"$ref":"#/$defs/digest"}}}
