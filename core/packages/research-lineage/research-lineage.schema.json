    "lineage":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","lineage_id","project_ref","lineage_kind","baseline_snapshot","created_at","actor","creation_action_ref","status","current_snapshot","project_config","effective_profile_set","rationale","execution_mode","lineage_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"research_lineage"},"lineage_id":{"$ref":"#/$defs/id"},"project_ref":{"$ref":"#/$defs/id"},"lineage_kind":{"enum":["primary","exploratory_fork","corrective_recovery"]},"parent_lineage_ref":{"$ref":"#/$defs/id"},"baseline_snapshot":{"$ref":"#/$defs/snapshot"},"created_at":{"type":"string","format":"date-time"},"actor":{"$ref":"#/$defs/actor"},"creation_action_ref":{"$ref":"#/$defs/id"},"creation_decision_ref":{"$ref":"#/$defs/id"},"status":{"enum":["active","paused","superseded","abandoned","completed"]},"current_snapshot":{"$ref":"#/$defs/snapshot"},"project_config":{"$ref":"#/$defs/pin"},"effective_profile_set":{"$ref":"#/$defs/pin"},"rationale":{"type":"string","minLength":1},"execution_mode":{"enum":["real","virtual"]},"lineage_digest":{"$ref":"#/$defs/digest"}},"allOf":[{"if":{"properties":{"lineage_kind":{"enum":["exploratory_fork","corrective_recovery"]}},"required":["lineage_kind"]},"then":{"required":["parent_lineage_ref","creation_decision_ref"]}}]},
    "fork_proposal":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","proposal_id","project_ref","requested_baseline_lineage","baseline_snapshot","reason","fork_kind","intended_divergence","affected_refs","proposed_project_config_changes","proposed_profile_changes","expected_downstream_impact","provenance_ref","proposal_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"fork_proposal"},"proposal_id":{"$ref":"#/$defs/id"},"project_ref":{"$ref":"#/$defs/id"},"requested_baseline_lineage":{"$ref":"#/$defs/id"},"baseline_snapshot":{"$ref":"#/$defs/snapshot"},"reason":{"type":"string","minLength":1},"fork_kind":{"enum":["exploratory_fork","corrective_recovery"]},"intended_divergence":{"type":"string","minLength":1},"affected_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"proposed_project_config_changes":{"type":"array","items":{"type":"string","minLength":1}},"proposed_profile_changes":{"type":"array","items":{"type":"string","minLength":1}},"expected_downstream_impact":{"type":"array","items":{"type":"string","minLength":1}},"provenance_ref":{"$ref":"#/$defs/id"},"proposal_digest":{"$ref":"#/$defs/digest"}}},
