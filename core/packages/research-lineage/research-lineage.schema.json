    "impact_assessment":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","assessment_id","project_ref","source_lineage_ref","baseline_snapshot","items","incomplete_impact_possible","assessment_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"impact_assessment"},"assessment_id":{"$ref":"#/$defs/id"},"project_ref":{"$ref":"#/$defs/id"},"source_lineage_ref":{"$ref":"#/$defs/id"},"baseline_snapshot":{"$ref":"#/$defs/snapshot"},"items":{"type":"array","items":{"$ref":"#/$defs/impact_item"}},"incomplete_impact_possible":{"const":true},"assessment_digest":{"$ref":"#/$defs/digest"}}},
    "recovery_request":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","request_id","project_ref","source_lineage_ref","reason","affected_run_refs","affected_state_refs","known_good_baseline","defect_version","proposed_replay_point","known_downstream_consumers","uncertainty","request_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"recovery_request"},"request_id":{"$ref":"#/$defs/id"},"project_ref":{"$ref":"#/$defs/id"},"source_lineage_ref":{"$ref":"#/$defs/id"},"reason":{"type":"string","minLength":1},"affected_run_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"affected_state_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"known_good_baseline":{"$ref":"#/$defs/snapshot"},"defect_version":{"type":"string","minLength":1},"proposed_replay_point":{"$ref":"#/$defs/id"},"known_downstream_consumers":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"uncertainty":{"type":"string","minLength":1},"request_digest":{"$ref":"#/$defs/digest"}}},
    "replay_plan":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","replay_plan_id","source_lineage_ref","baseline_snapshot","target_lineage_ref","replay_start_boundary","selected_method_refs","context_pack_construction","required_human_decision_refs","capability_sequence_proposals","known_excluded_refs","run_id_policy","handoff_copy_allowed","status","plan_digest"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"replay_plan"},"replay_plan_id":{"$ref":"#/$defs/id"},"source_lineage_ref":{"$ref":"#/$defs/id"},"baseline_snapshot":{"$ref":"#/$defs/snapshot"},"target_lineage_ref":{"$ref":"#/$defs/id"},"replay_start_boundary":{"$ref":"#/$defs/id"},"selected_method_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"context_pack_construction":{"const":"rebuild_from_target_lineage"},"required_human_decision_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"capability_sequence_proposals":{"type":"array","items":{"$ref":"#/$defs/id"}},"known_excluded_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"run_id_policy":{"const":"new_run_ids_only"},"handoff_copy_allowed":{"const":false},"status":{"enum":["approved","running","completed","interrupted","partial"]},"plan_digest":{"$ref":"#/$defs/digest"}}},
