{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:research-loom:writer-publication:publication-application:0.1.0",
  "title":"Explicit Publication application inputs",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "formal_spec_profile":{
      "type":"object","additionalProperties":false,
      "required":["profile_id","profile_version","source","docx_layout","reference_list_placement","research_group_type_required"],
      "properties":{
        "profile_id":{"type":"string","minLength":1,"maxLength":256},
        "profile_version":{"type":"string","minLength":1,"maxLength":64},
        "source":{"$ref":"#/$defs/source_pin"},
        "docx_layout":{
          "type":"object","additionalProperties":false,
          "required":["page_width_twips","page_height_twips","margin_top_twips","margin_right_twips","margin_bottom_twips","margin_left_twips","body_font","body_size_half_points","heading_font","heading1_size_half_points","heading2_size_half_points","title_font","title_size_half_points","table_font","table_body_size_half_points","table_header_size_half_points","first_line_indent_twips"],
          "properties":{
            "page_width_twips":{"type":"integer","minimum":1000,"maximum":50000},
            "page_height_twips":{"type":"integer","minimum":1000,"maximum":50000},
            "margin_top_twips":{"type":"integer","minimum":0,"maximum":20000},
            "margin_right_twips":{"type":"integer","minimum":0,"maximum":20000},
            "margin_bottom_twips":{"type":"integer","minimum":0,"maximum":20000},
            "margin_left_twips":{"type":"integer","minimum":0,"maximum":20000},
            "body_font":{"$ref":"#/$defs/font_name"},
            "body_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "heading_font":{"$ref":"#/$defs/font_name"},
            "heading1_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "heading2_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "title_font":{"$ref":"#/$defs/font_name"},
            "title_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "table_font":{"$ref":"#/$defs/font_name"},
            "table_body_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "table_header_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "first_line_indent_twips":{"type":"integer","minimum":0,"maximum":10000},
            "header_margin_twips":{"type":"integer","minimum":0,"maximum":20000},
            "footer_margin_twips":{"type":"integer","minimum":0,"maximum":20000},
            "doc_grid_line_pitch_twips":{"type":"integer","minimum":1,"maximum":10000},
            "doc_grid_char_space":{"type":"integer","minimum":-100000,"maximum":100000},
            "body_latin_font":{"$ref":"#/$defs/font_name"},
            "heading_latin_font":{"$ref":"#/$defs/font_name"},
            "title_latin_font":{"$ref":"#/$defs/font_name"},
            "table_latin_font":{"$ref":"#/$defs/font_name"},
            "caption_font":{"$ref":"#/$defs/font_name"},
            "caption_latin_font":{"$ref":"#/$defs/font_name"},
            "caption_size_half_points":{"type":"integer","minimum":8,"maximum":144},
            "reference_left_indent_twips":{"type":"integer","minimum":0,"maximum":10000},
            "reference_hanging_twips":{"type":"integer","minimum":0,"maximum":10000}
          }
        },
        "reference_list_placement":{"enum":["end_of_document","end_of_each_section"]},
        "research_group_type_required":{"type":"boolean"},
        "reference_list_heading":{"type":"string","minLength":1,"maxLength":128}
      }
    },
    "url_display_profile":{
      "type":"object","additionalProperties":false,
      "required":["profile_id","profile_version","source","template"],
      "properties":{
        "profile_id":{"type":"string","minLength":1,"maxLength":256},
        "profile_version":{"type":"string","minLength":1,"maxLength":64},
        "source":{"$ref":"#/$defs/source_pin"},
        "template":{"type":"string","minLength":5,"maxLength":1024}
      }
    },
    "research_group_type":{"type":"string","minLength":1,"maxLength":128},
    "permissions":{"type":"array","maxItems":256,"items":{
      "type":"object","additionalProperties":false,
      "required":["source_ref","publication_allowed","company_disclosure","original_reviewed","approval_ref"],
      "properties":{
        "source_ref":{"type":"string","minLength":1,"maxLength":256},
        "publication_allowed":{"type":"boolean"},
        "company_disclosure":{"enum":["allowed","anonymized","prohibited"]},
        "original_reviewed":{"type":"boolean"},
        "approval_ref":{"type":"string","minLength":1,"maxLength":512}
      }
    }},
    "editorial_review":{
      "type":"object","additionalProperties":false,
      "required":["reviewer_id","reviewed_at","checks"],
      "properties":{
        "reviewer_id":{"type":"string","minLength":1,"maxLength":256},
        "reviewed_at":{"type":"string","format":"date-time"},
        "checks":{"type":"array","minItems":1,"maxItems":128,"items":{
          "type":"object","additionalProperties":false,
          "required":["check_id","status","rationale"],
          "properties":{
            "check_id":{"type":"string","minLength":1,"maxLength":256},
            "status":{"enum":["passed","warning","failed","unevaluated","not_applicable"]},
            "rationale":{"type":"string","minLength":1,"maxLength":4000}
          }
        }}
      }
    }
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "font_name":{"type":"string","minLength":1,"maxLength":128},
    "source_pin":{
      "type":"object","additionalProperties":false,
      "required":["source_ref","source_digest","approval_ref"],
      "properties":{
        "source_ref":{"type":"string","minLength":1,"maxLength":1024},
        "source_digest":{"$ref":"#/$defs/sha"},
        "approval_ref":{"type":"string","minLength":1,"maxLength":1024}
      }
    }
  }
}
