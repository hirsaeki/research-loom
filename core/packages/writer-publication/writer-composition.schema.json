{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-loom:core:writer-publication:writer-composition:0.1.0",
  "title": "Versioned evidence-linked Writer Composition and detached Section Writer Input",
  "oneOf": [
    {"$ref": "#/$defs/writer_composition"},
    {"$ref": "#/$defs/section_writer_input"},
    {"$ref": "#/$defs/section_writer_input_manifest"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_package_id", "research_package_digest", "project_id", "lineage_ref", "research_snapshot_id", "research_snapshot_digest", "effective_profile_set_ref", "effective_profile_set_digest"],
      "properties": {
        "research_package_id": {"$ref": "#/$defs/id"},
        "research_package_digest": {"$ref": "#/$defs/digest"},
        "project_id": {"$ref": "#/$defs/id"},
        "lineage_ref": {"$ref": "#/$defs/id"},
        "research_snapshot_id": {"$ref": "#/$defs/id"},
        "research_snapshot_digest": {"$ref": "#/$defs/digest"},
        "effective_profile_set_ref": {"$ref": "#/$defs/id"},
        "effective_profile_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "section_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "parent_section_id", "order", "heading", "reader_question", "purpose", "narrative_stage_refs", "semantic_purpose_refs", "messages", "opening_intent", "closing_intent", "previous_section_id", "next_section_id", "length_hint", "prohibited_claims", "unresolved_items", "detailed", "argument_refs", "finding_refs", "evidence_refs", "source_refs", "counter_review_refs", "qualifier_refs", "limitation_refs", "contribution_refs", "recommendation_refs", "exhibit_refs", "gap_refs", "material_refs", "citation_requirements", "section_digest"],
      "properties": {
        "section_id": {"$ref": "#/$defs/id"},
        "parent_section_id": {"type": ["string", "null"]},
        "order": {"type": "integer"},
        "heading": {"type": "string", "minLength": 1},
        "reader_question": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "narrative_stage_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "semantic_purpose_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "messages": {"type": "array", "items": {"type": "string"}},
        "opening_intent": {"type": "string"},
        "closing_intent": {"type": "string"},
        "previous_section_id": {"type": ["string", "null"]},
        "next_section_id": {"type": ["string", "null"]},
        "length_hint": {"type": ["integer", "null"]},
        "prohibited_claims": {"type": "array", "items": {"type": "string"}},
        "unresolved_items": {"type": "array", "items": {"type": "string"}},
        "detailed": {"type": "boolean"},
        "argument_refs": {"$ref": "#/$defs/ids"},
        "finding_refs": {"$ref": "#/$defs/ids"},
        "evidence_refs": {"$ref": "#/$defs/ids"},
        "source_refs": {"$ref": "#/$defs/ids"},
        "counter_review_refs": {"$ref": "#/$defs/ids"},
        "qualifier_refs": {"$ref": "#/$defs/ids"},
        "limitation_refs": {"$ref": "#/$defs/ids"},
        "contribution_refs": {"$ref": "#/$defs/ids"},
        "recommendation_refs": {"$ref": "#/$defs/ids"},
        "exhibit_refs": {"$ref": "#/$defs/ids"},
        "gap_refs": {"$ref": "#/$defs/ids"},
        "material_refs": {"$ref": "#/$defs/ids"},
        "citation_requirements": {"type": "array", "items": {"type": "object", "required": ["source_ref", "locator_ref"], "properties": {"source_ref": {"$ref": "#/$defs/id"}, "locator_ref": {"type": ["string", "null"]}}, "additionalProperties": false}},
        "section_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "writer_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "object_type", "composition_id", "version", "source", "purpose", "audience", "sections", "base_version", "base_digest", "change_reason", "created_by", "created_at", "validation", "research_state_mutation_performed", "evidence_verification_performed", "finding_adoption_performed", "composition_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "writer_composition"},
        "composition_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/source_pin"},
        "purpose": {"type": "string", "minLength": 1},
        "audience": {"type": "array", "items": {"type": "string"}},
        "sections": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/section_contract"}},
        "base_version": {"type": ["integer", "null"]},
        "base_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "change_reason": {"type": "string"},
        "created_by": {"type": "object"},
        "created_at": {"type": "string", "format": "date-time"},
        "validation": {"type": "object", "required": ["status", "diagnostics"]},
        "research_state_mutation_performed": {"const": false},
        "evidence_verification_performed": {"const": false},
        "finding_adoption_performed": {"const": false},
        "composition_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "section_writer_input": {
      "type": "object",
      "required": ["schema_version", "object_type", "source", "communication", "outline_context", "section_contract", "resolved_research_objects", "resolved_materials", "resolved_exhibits", "unresolved_gaps", "resolved_profile_constraints", "authority_boundary", "section_input_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "section_writer_input"},
        "section_contract": {"$ref": "#/$defs/section_contract"},
        "section_input_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "section_writer_input_manifest": {
      "type": "object",
      "required": ["schema_version", "object_type", "files", "manifest_digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "object_type": {"const": "section_writer_input_manifest"},
        "files": {"type": "array", "minItems": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
