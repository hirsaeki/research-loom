{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:research-loom:core:writer-publication:publication-preview:0.1.0",
  "title":"Canonical Publication Preview, Profile Defect, and Preview Iteration contracts",
  "oneOf":[{"$ref":"#/$defs/preview_artifact_manifest"},{"$ref":"#/$defs/profile_defect_candidate"},{"$ref":"#/$defs/preview_iteration"}],
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"semver":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},"ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "profile_pin":{"type":"object","additionalProperties":false,"required":["profile_id","profile_version","content_digest"],"properties":{"profile_id":{"$ref":"#/$defs/id"},"profile_version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"}}},
    "artifact_pin":{"type":"object","additionalProperties":false,"required":["artifact_id","version","content_digest"],"properties":{"artifact_id":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/semver"},"content_digest":{"$ref":"#/$defs/digest"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["generated_at","tool_id","tool_version","input_digests"],"properties":{"generated_at":{"type":"string","format":"date-time"},"tool_id":{"$ref":"#/$defs/id"},"tool_version":{"$ref":"#/$defs/semver"},"input_digests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/digest"}}}},
    "preview_artifact_manifest":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","preview_id","source_manuscript","source_epistemic_status","publication_profile","template_pin","style_map_pin","renderer","outputs","validation_checks","preview_only","release_eligible","published_artifact","release_manifest","content_digest","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"preview_artifact_manifest"},"preview_id":{"$ref":"#/$defs/id"},"source_manuscript":{"type":"object","additionalProperties":false,"required":["manuscript_id","manuscript_digest"],"properties":{"manuscript_id":{"$ref":"#/$defs/id"},"manuscript_digest":{"$ref":"#/$defs/digest"}}},"source_epistemic_status":{"enum":["SYNTHETIC_TEST_ONLY","EMPIRICAL_RESEARCH_STATE"]},"publication_profile":{"$ref":"#/$defs/profile_pin"},"template_pin":{"$ref":"#/$defs/artifact_pin"},"style_map_pin":{"$ref":"#/$defs/artifact_pin"},"renderer":{"type":"object","additionalProperties":false,"required":["renderer_id","renderer_version","tool_digest"],"properties":{"renderer_id":{"$ref":"#/$defs/id"},"renderer_version":{"$ref":"#/$defs/semver"},"tool_digest":{"$ref":"#/$defs/digest"}}},"outputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["format","path","output_digest","input_template_digest","input_style_map_digest"],"properties":{"format":{"enum":["docx","pdf"]},"path":{"type":"string","minLength":1},"output_digest":{"$ref":"#/$defs/digest"},"input_template_digest":{"$ref":"#/$defs/digest"},"input_style_map_digest":{"$ref":"#/$defs/digest"}}}},"validation_checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["check_id","status","defect_refs"],"properties":{"check_id":{"$ref":"#/$defs/id"},"status":{"enum":["passed","warning","failed"]},"defect_refs":{"$ref":"#/$defs/ids"}}}},"preview_only":{"const":true},"release_eligible":{"const":false},"published_artifact":{"const":false},"release_manifest":{"const":false},"content_digest":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/provenance"}}},
    "profile_defect_candidate":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","defect_id","defect_kind","layer","affected_profile_or_path","observed_behavior","expected_behavior","source_preview_refs","severity","proposed_revision","disposition","mutation_performed","core_invariant_weakening_proposed","content_digest","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"profile_defect_candidate"},"defect_id":{"$ref":"#/$defs/id"},"defect_kind":{"enum":["PROFILE_RULE_CONFLICT","UNRESOLVED_CITATION","MISSING_EXHIBIT","CROSS_REFERENCE","NARRATIVE_CONSTRAINT_CONFLICT","PACKAGE_TRACEABILITY_GAP"]},"layer":{"enum":["narrative_profile","publication_profile","project_config","writer_contract","publication_contract","research_package"]},"affected_profile_or_path":{"type":"string","minLength":1},"affected_version":{"$ref":"#/$defs/semver"},"observed_behavior":{"type":"string","minLength":1},"expected_behavior":{"type":"string","minLength":1},"source_preview_refs":{"$ref":"#/$defs/ids"},"severity":{"enum":["minor","major","critical"]},"proposed_revision":{"type":"string","minLength":1},"disposition":{"enum":["candidate","accepted_for_revision","rejected","resolved"]},"mutation_performed":{"const":false},"core_invariant_weakening_proposed":{"const":false},"content_digest":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/provenance"}}},
    "preview_iteration":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","iteration_id","previous_preview","new_preview","previous_profile_pin","new_profile_pin","human_reviewed_revision","previous_artifact_overwritten","input_pins_changed","content_digest","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"preview_iteration"},"iteration_id":{"$ref":"#/$defs/id"},"previous_preview":{"type":"object","additionalProperties":false,"required":["preview_id","content_digest"],"properties":{"preview_id":{"$ref":"#/$defs/id"},"content_digest":{"$ref":"#/$defs/digest"}}},"new_preview":{"type":"object","additionalProperties":false,"required":["preview_id","content_digest"],"properties":{"preview_id":{"$ref":"#/$defs/id"},"content_digest":{"$ref":"#/$defs/digest"}}},"previous_profile_pin":{"$ref":"#/$defs/profile_pin"},"new_profile_pin":{"$ref":"#/$defs/profile_pin"},"human_reviewed_revision":{"const":true},"previous_artifact_overwritten":{"const":false},"input_pins_changed":{"const":true},"content_digest":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/provenance"}}}
  }
}
