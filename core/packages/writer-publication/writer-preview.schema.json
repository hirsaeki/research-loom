{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:research-loom:core:writer-publication:writer-preview:0.1.0",
  "title":"Canonical Writer Outline and Writing Feedback contracts",
  "oneOf":[{"$ref":"#/$defs/outline_package"},{"$ref":"#/$defs/writing_feedback_package"}],
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "semver":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "source_binding":{"type":"object","additionalProperties":false,"required":["research_package_id","research_package_digest","research_snapshot_id","research_snapshot_digest"],"properties":{"research_package_id":{"$ref":"#/$defs/id"},"research_package_digest":{"$ref":"#/$defs/digest"},"research_snapshot_id":{"$ref":"#/$defs/id"},"research_snapshot_digest":{"$ref":"#/$defs/digest"}}},
    "citation_requirement":{"type":"object","additionalProperties":false,"required":["source_ref","locator_ref"],"properties":{"source_ref":{"$ref":"#/$defs/id"},"locator_ref":{"$ref":"#/$defs/id"}}},
    "section_contract":{"type":"object","additionalProperties":false,"required":["section_id","semantic_purpose_ref","narrative_stage_ref","reader_need","argument_refs","finding_refs","evidence_refs","counter_review_refs","qualifier_refs","limitation_refs","contribution_refs","recommendation_refs","exhibit_requirements","citation_requirements","opening_intent","closing_intent","dependency_bridge_hints","emphasis_hints","prohibited_claims","generated_heading"],"properties":{"section_id":{"$ref":"#/$defs/id"},"semantic_purpose_ref":{"$ref":"#/$defs/id"},"narrative_stage_ref":{"$ref":"#/$defs/id"},"reader_need":{"type":"string","minLength":1},"argument_refs":{"$ref":"#/$defs/ids"},"finding_refs":{"$ref":"#/$defs/ids"},"evidence_refs":{"$ref":"#/$defs/ids"},"counter_review_refs":{"$ref":"#/$defs/ids"},"qualifier_refs":{"$ref":"#/$defs/ids"},"limitation_refs":{"$ref":"#/$defs/ids"},"contribution_refs":{"$ref":"#/$defs/ids"},"recommendation_refs":{"$ref":"#/$defs/ids"},"exhibit_requirements":{"$ref":"#/$defs/ids"},"citation_requirements":{"type":"array","items":{"$ref":"#/$defs/citation_requirement"}},"opening_intent":{"type":"string","minLength":1},"closing_intent":{"type":"string","minLength":1},"dependency_bridge_hints":{"type":"array","items":{"type":"string","minLength":1}},"length_hint":{"type":"integer","minimum":1},"emphasis_hints":{"type":"array","items":{"type":"string","minLength":1}},"prohibited_claims":{"type":"array","items":{"type":"string","minLength":1}},"generated_heading":{"type":"object","additionalProperties":false,"required":["text","authoritative"],"properties":{"text":{"type":"string","minLength":1},"authoritative":{"const":false}}}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["generated_at","tool_id","tool_version","input_digests"],"properties":{"generated_at":{"type":"string","format":"date-time"},"tool_id":{"$ref":"#/$defs/id"},"tool_version":{"$ref":"#/$defs/semver"},"input_digests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/digest"}}}},
    "outline_package":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","outline_id","outline_version","outline_mode","source_epistemic_status","source","research_authority","release_eligible","sections","outline_digest","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"outline_package"},"outline_id":{"$ref":"#/$defs/id"},"outline_version":{"$ref":"#/$defs/semver"},"outline_mode":{"enum":["preview","real"]},"source_epistemic_status":{"enum":["SYNTHETIC_TEST_ONLY","EMPIRICAL_RESEARCH_STATE"]},"source":{"$ref":"#/$defs/source_binding"},"research_authority":{"const":false},"release_eligible":{"const":false},"sections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/section_contract"}},"outline_digest":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/provenance"}},"allOf":[{"if":{"properties":{"source_epistemic_status":{"const":"SYNTHETIC_TEST_ONLY"}}},"then":{"properties":{"outline_mode":{"const":"preview"}}}}]},
    "issue":{"type":"object","additionalProperties":false,"required":["issue_id","target_type","target_id","issue_category","description","severity","supporting_package_refs","proposed_next_action"],"properties":{"issue_id":{"$ref":"#/$defs/id"},"target_type":{"enum":["research_object","argument","section","package"]},"target_id":{"$ref":"#/$defs/id"},"issue_category":{"enum":["MISSING_EVIDENCE","AMBIGUOUS_SCOPE","UNSUPPORTED_ARGUMENT","MISSING_ARGUMENT_LINK","QUALIFIER_CONFLICT","LIMITATION_CONFLICT","COUNTEREVIDENCE_NOT_INTEGRATED","NARRATIVE_CONSTRAINT_CONFLICT","COMMUNICATION_BRIEF_GAP","PACKAGE_TRACEABILITY_GAP","UNKNOWN"]},"description":{"type":"string","minLength":1},"severity":{"enum":["minor","major","critical"]},"supporting_package_refs":{"$ref":"#/$defs/ids"},"proposed_next_action":{"type":"string","minLength":1}}},
    "writing_feedback_package":{"type":"object","additionalProperties":false,"required":["schema_version","object_type","feedback_id","source","source_outline_ref","issues","is_research_evidence","research_state_mutation_performed","feedback_digest","provenance"],"properties":{"schema_version":{"const":"0.1.0"},"object_type":{"const":"writing_feedback_package"},"feedback_id":{"$ref":"#/$defs/id"},"source":{"$ref":"#/$defs/source_binding"},"source_outline_ref":{"type":"object","additionalProperties":false,"required":["outline_id","outline_digest"],"properties":{"outline_id":{"$ref":"#/$defs/id"},"outline_digest":{"$ref":"#/$defs/digest"}}},"issues":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/issue"}},"is_research_evidence":{"const":false},"research_state_mutation_performed":{"const":false},"feedback_digest":{"$ref":"#/$defs/digest"},"provenance":{"$ref":"#/$defs/provenance"}}}
  }
}
